// Jenkins equivalent of .gitlab-ci.yml (demonstration).
// Credentials to create in Jenkins:
//   registry-creds      username/password for the image registry
//   flotte-config-token secret text, write access to flotte-config
pipeline {
  agent any
  environment {
    REGISTRY_IMAGE = 'registry.gitlab.com/<GITLAB_USER>/flotte-app'
    FLOTTE_CONFIG_URL = 'https://gitlab.com/<GITLAB_USER>/flotte-config.git'
  }
  stages {
    stage('Build image') {
      steps {
        script { env.IMAGE = "${env.REGISTRY_IMAGE}:${env.GIT_COMMIT.take(8)}" }
        withCredentials([usernamePassword(credentialsId: 'registry-creds',
                         usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
          sh 'echo "$REG_PASS" | docker login -u "$REG_USER" --password-stdin registry.gitlab.com'
          sh 'docker build --build-arg GIT_SHA="$GIT_COMMIT" -t "$IMAGE" .'
          sh 'docker push "$IMAGE"'
        }
      }
    }
    stage('Update flotte-config') {
      when { branch 'main' }
      steps {
        withCredentials([string(credentialsId: 'flotte-config-token', variable: 'TOKEN')]) {
          sh '''
            CONFIG_REPO_URL="$FLOTTE_CONFIG_URL" CONFIG_TOKEN="$TOKEN" \
              NEW_IMAGE="$IMAGE" COMMIT_AUTHOR="flotte-jenkins" sh ci/update-config.sh
          '''
        }
      }
    }
  }
}
